<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- PNG decoding for the offline pupil-detector harness (the "pupil" command-line mode). -->
    <UseWPF>true</UseWPF>
    <BaseOutputPath>$(SolutionDir)build\$(PlatformTarget)\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="call prebuild.bat $(SolutionDir)\externs\dlls $(OutputPath) $(SolutionDir)models" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="call postbuild.bat $(OutputPath) $(SolutionDir)..\..\..\..\build\$(Configuration)\runtime" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\module\WsoNativeLib\WsoNativeLib.csproj" />
  </ItemGroup>
</Project>
