<Window x:Class="WsoToolkit.LsoGalvoCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="FOV Slit Calibration" Style="{StaticResource WindowStyle}"
        Width="{DynamicResource CalibrationWindowWidth}" Height="{DynamicResource CalibrationWindowHeight}"
        MinWidth="{DynamicResource CalibrationMinimumWidth}" MinHeight="{DynamicResource CalibrationMinimumHeight}"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <!-- Local extension of shared native-control styles and 4/8-unit spacing. -->
        <sys:Double x:Key="CalibrationWindowWidth">1040</sys:Double>
        <sys:Double x:Key="CalibrationWindowHeight">680</sys:Double>
        <sys:Double x:Key="CalibrationMinimumWidth">760</sys:Double>
        <sys:Double x:Key="CalibrationMinimumHeight">520</sys:Double>
        <sys:Double x:Key="CalibrationWideActionWidth">160</sys:Double>
        <sys:Double x:Key="CalibrationMinimumColumnWidth">96</sys:Double>
        <Thickness x:Key="CalibrationSpace">8</Thickness>
        <Thickness x:Key="CalibrationInset">4</Thickness>
        <Thickness x:Key="CalibrationSectionGap">0,0,0,8</Thickness>
        <Thickness x:Key="CalibrationColumnGap">0,0,8,0</Thickness>
        <Thickness x:Key="CalibrationActionGap">4,0,0,0</Thickness>
        <Thickness x:Key="CalibrationFooterGap">0,8,0,0</Thickness>
        <Style x:Key="CalibrationActionStyle" TargetType="Button" BasedOn="{StaticResource ButtonM1Style}">
            <Setter Property="Margin" Value="{StaticResource CalibrationActionGap}"/>
        </Style>
        <Style x:Key="CalibrationWideActionStyle" TargetType="Button" BasedOn="{StaticResource CalibrationActionStyle}">
            <Setter Property="Width" Value="{StaticResource CalibrationWideActionWidth}"/>
        </Style>
        <Style x:Key="CalibrationSectionStyle" TargetType="GroupBox">
            <Setter Property="Padding" Value="{StaticResource CalibrationInset}"/>
            <Setter Property="Margin" Value="{StaticResource CalibrationSectionGap}"/>
        </Style>
        <Style x:Key="CalibrationTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="{StaticResource CalibrationSpace}">
        <GroupBox DockPanel.Dock="Top" Header="Preset target" Style="{StaticResource CalibrationSectionStyle}">
            <StackPanel>
                <Label x:Name="myLbTarget" Style="{StaticResource HeaderStyle2}"/>
                <TextBlock x:Name="myTbTargetState" Style="{StaticResource CalibrationTextStyle}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox DockPanel.Dock="Top" Header="Calibration JSON" Style="{StaticResource CalibrationSectionStyle}">
            <DockPanel>
                <Button x:Name="myBtLoad" DockPanel.Dock="Right" Content="Load JSON..." Style="{StaticResource CalibrationActionStyle}" Click="myBtLoad_Click"/>
                <Button x:Name="myBtSave" DockPanel.Dock="Right" Content="Save JSON..." Style="{StaticResource CalibrationActionStyle}" Click="myBtSave_Click"/>
                <TextBlock x:Name="myTbFile" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </GroupBox>
        <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource CalibrationFooterGap}">
            <TextBlock x:Name="myTbStatus" Style="{StaticResource CalibrationTextStyle}"/>
            <DockPanel Margin="{StaticResource CalibrationFooterGap}">
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource CalibrationActionStyle}" Click="myBtClose_Click"/>
                <Button x:Name="myBtUse" DockPanel.Dock="Right" Content="Save &amp; Apply"
                        Style="{StaticResource CalibrationWideActionStyle}" Click="myBtUse_Click"
                        ToolTip="Write the default and camera-specific JSON, and select Calibrated FOV Curve for the original preset in memory. Save Settings to persist the preset."/>
                <TextBlock Style="{StaticResource CalibrationTextStyle}" VerticalAlignment="Center"
                           Text="Alignment: select, Move, measure; Auto-Next moves to the next point."/>
            </DockPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <GroupBox Header="Measured points" Style="{StaticResource CalibrationSectionStyle}" Margin="{StaticResource CalibrationColumnGap}">
                <DockPanel>
                    <WrapPanel x:Name="myPanelPointActions" DockPanel.Dock="Top" Margin="{StaticResource CalibrationSectionGap}">
                        <Button Content="Add point" Style="{StaticResource CalibrationActionStyle}" Click="myBtAdd_Click"/>
                        <Button Content="Delete points" Style="{StaticResource CalibrationActionStyle}" Click="myBtDelete_Click"/>
                        <Button Content="Reset Nominal" Style="{StaticResource CalibrationActionStyle}" Click="myBtReset_Click"/>
                        <Button x:Name="myBtPrev" Content="Prev" Style="{StaticResource CalibrationActionStyle}" Click="myBtPrev_Click"/>
                        <Button x:Name="myBtMove" Content="Move" Style="{StaticResource CalibrationActionStyle}" Click="myBtMove_Click"/>
                        <Button x:Name="myBtNext" Content="Next" Style="{StaticResource CalibrationActionStyle}" Click="myBtNext_Click"/>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource CalibrationFooterGap}">
                        <WrapPanel>
                            <Button x:Name="myBtRecord" Content="Record (1-click)" Style="{StaticResource CalibrationActionStyle}" Click="myBtRecord_Click"/>
                            <Button x:Name="myBtTwoClick" Content="2-click" Style="{StaticResource CalibrationActionStyle}" Click="myBtTwoClick_Click"/>
                            <Button x:Name="myBtLive" Content="Live" Style="{StaticResource CalibrationActionStyle}" Click="myBtLive_Click"/>
                            <CheckBox x:Name="myCheckAutoNext" Content="Auto-Next" VerticalAlignment="Center" Margin="4"/>
                            <Button x:Name="myBtCancel" Content="Cancel" IsEnabled="False" Style="{StaticResource CalibrationActionStyle}" Click="myBtCancel_Click"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource CalibrationTextStyle}" Margin="{StaticResource CalibrationFooterGap}"
                                   Text="DAC: -32768..32767. SensorRow: absolute sensor coordinate; blank means unmeasured. Live locks the optical-center row from the frame."/>
                    </StackPanel>
                    <DataGrid x:Name="myGridPoints" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              MinColumnWidth="{StaticResource CalibrationMinimumColumnWidth}"
                              SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Galvo DAC" Width="*" Binding="{Binding GalvoDac, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="SensorRow" Width="*" Binding="{Binding SensorRow, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Residual (DAC)" Width="*" IsReadOnly="True" Binding="{Binding Residual}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Fit: DAC(SensorRow)" Style="{StaticResource CalibrationSectionStyle}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="{StaticResource CalibrationSectionGap}">
                        <Label Content="Polynomial order :" Style="{StaticResource LabelStyle2}"/>
                        <ComboBox x:Name="myCbOrder" Style="{StaticResource ComboBoxStyle}" SelectionChanged="myCbOrder_SelectionChanged"/>
                        <Button x:Name="myBtFit" Content="Fit" Style="{StaticResource CalibrationActionStyle}" Click="myBtFit_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="myTbFit" DockPanel.Dock="Top" Style="{StaticResource CalibrationTextStyle}" Margin="{StaticResource CalibrationSectionGap}"/>
                    <Border Style="{StaticResource BorderStyle}">
                        <oxy:PlotView x:Name="myPlot" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    </Border>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
