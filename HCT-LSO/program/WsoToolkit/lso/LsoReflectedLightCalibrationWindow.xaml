<Window x:Class="WsoToolkit.LsoReflectedLightCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reflected Light Calibration" Style="{StaticResource WindowStyle}"
        Width="760" Height="490" MinWidth="680" MinHeight="450"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar x:Name="myProgress" Height="20" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="myStatus" Text="Ready." TextWrapping="Wrap" Margin="0,8,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="myStart" Content="Start" Style="{StaticResource ButtonM1Style}" Click="Start_Click"/>
                <Button x:Name="myCancel" Content="Close" Style="{StaticResource ButtonM1Style}" Margin="8,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <GroupBox Header="Current calibration" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="mySummary" TextWrapping="Wrap"/>
                    <TextBlock x:Name="myFolder" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>
            <StackPanel x:Name="myInputs">
                <GroupBox Header="Raw capture ROI (pixels, even values)" Padding="8" Margin="0,0,0,8">
                    <WrapPanel>
                        <Label Content="X" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="myX" Text="1600" Width="68" Style="{StaticResource TextBoxS2Style}"/>
                        <Label Content="Y" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="myY" Text="1600" Width="68" Style="{StaticResource TextBoxS2Style}"/>
                        <Label Content="W" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="myWidth" Text="448" Width="68" Style="{StaticResource TextBoxS2Style}"/>
                        <Label Content="H" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="myHeight" Text="600" Width="68" Style="{StaticResource TextBoxS2Style}"/>
                    </WrapPanel>
                </GroupBox>
                <GroupBox Header="Focus sweep" Padding="8">
                    <StackPanel>
                        <WrapPanel>
                            <Label Content="Start D" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="myFrom" Text="-15" Width="64" Style="{StaticResource TextBoxS2Style}" TextChanged="Range_TextChanged"/>
                            <Label Content="End D" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="myTo" Text="15" Width="64" Style="{StaticResource TextBoxS2Style}" TextChanged="Range_TextChanged"/>
                            <Label Content="Step D" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="myStep" Text="0.5" Width="64" Style="{StaticResource TextBoxS2Style}"/>
                            <Label Content="Frames / point" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="myFrames" Text="8" Width="48" Style="{StaticResource TextBoxS2Style}"/>
                        </WrapPanel>
                        <TextBlock x:Name="myWarning" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
