<Window x:Class="WsoToolkit.LsoStitchSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WsoToolkit"
        Title="Stitch Settings" Height="400" Width="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Band Height (rows) :" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="myTbBandHeight" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                 ToolTip="One band's height. 0 = derive it from the capture (frame height / Sub Frame Count)."/>

        <Label Grid.Row="1" Grid.Column="0" Content="Margin Ratio :" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="myTbMarginRatio" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                 ToolTip="How much is taken beyond the band on each side, as a fraction of the band height. 0 = hard cut (no overlap), 0.5 = half a band each way."/>

        <Label Grid.Row="2" Grid.Column="0" Content="Feather Curve :" Style="{StaticResource LabelStyle}"/>
        <ComboBox x:Name="myCbCurve" Grid.Row="2" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                  ToolTip="Shape of the cross-fade across a seam. Linear keeps the weights summing to 1; cosine eases in and out."/>

        <Label Grid.Row="3" Grid.Column="0" Content="Falloff Comp (%) :" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="myTbFalloff" Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                 ToolTip="How much darker a band's edge is than its centre. The merge divides that profile back out (gain capped at 4x). 0 = leave the image as captured."/>

        <Label Grid.Row="4" Grid.Column="0" Content="Edge Tail (rows) :" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="myTbEdgeTail" Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                 ToolTip="How far outside its own band a frame still carries usable signal. Caps the margin so black rows are never blended in. 0 = no cap."/>

        <Label Grid.Row="5" Grid.Column="0" Content="Band Offset (rows) :" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="myTbBandOffset" Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                 ToolTip="Shifts every band's crop together, for when the lit bands sit above or below where the subframe arithmetic puts them."/>

        <TextBlock x:Name="myLbSummary" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="#FF404040"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="Gray"
                   Text="Apply re-stitches the frames already in review - no new capture needed. Bands view draws the core (solid yellow) and the margin (dashed cyan) of each band."/>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="myBtDefaults" Content="Defaults" Style="{StaticResource ButtonM1Style}" Margin="4"
                    Click="myBtDefaults_Click"/>
            <Button x:Name="myBtApply" Content="Apply" Style="{StaticResource ButtonM1Style}" Margin="4"
                    Click="myBtApply_Click"/>
            <Button x:Name="myBtClose" Content="Close" Style="{StaticResource ButtonM1Style}" Margin="4"
                    Click="myBtClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
