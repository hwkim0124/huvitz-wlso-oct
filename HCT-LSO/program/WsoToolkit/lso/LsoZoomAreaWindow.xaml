<Window x:Class="WsoToolkit.LsoZoomAreaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LSO Zoom Area View (up to 60x)" Height="680" Width="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WindowStyle}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <!-- DevKit LsoZoomViewForm viewport colour. -->
        <SolidColorBrush x:Key="ZoomAreaViewportBrush" Color="#FF18181C"/>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,6">
            <Label Content="Zoom :" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:Name="myCbZoom" Style="{StaticResource ComboBoxM1Style}" Width="104" SelectionChanged="myCbZoom_SelectionChanged">
                <ComboBoxItem Content="Fit (Auto)" Tag="0" IsSelected="True"/>
                <ComboBoxItem Content="1x" Tag="1"/>
                <ComboBoxItem Content="2x" Tag="2"/>
                <ComboBoxItem Content="4x" Tag="4"/>
                <ComboBoxItem Content="8x" Tag="8"/>
                <ComboBoxItem Content="12x" Tag="12"/>
                <ComboBoxItem Content="16x" Tag="16"/>
                <ComboBoxItem Content="20x" Tag="20"/>
                <ComboBoxItem Content="25x" Tag="25"/>
                <ComboBoxItem Content="30x" Tag="30"/>
                <ComboBoxItem Content="40x" Tag="40"/>
                <ComboBoxItem Content="60x" Tag="60"/>
            </ComboBox>
            <Label Content="Filter :" Style="{StaticResource LabelStyle}" Margin="8,0,0,0"/>
            <ComboBox x:Name="myCbFilter" Style="{StaticResource ComboBoxM1Style}" Width="120" SelectionChanged="myCbFilter_SelectionChanged">
                <ComboBoxItem Content="Nearest (Pixels)" IsSelected="True"/>
                <ComboBoxItem Content="Bilinear (Smooth)"/>
            </ComboBox>
            <CheckBox x:Name="myCheckGrid" Content="Grid" Style="{StaticResource CheckBoxStyle}" Margin="10,0,0,0" IsChecked="True"
                      ToolTip="Pixel grid from 4x up." Checked="myCheckGrid_Changed" Unchecked="myCheckGrid_Changed"/>
            <CheckBox x:Name="myCheckFreeze" Content="Freeze" Style="{StaticResource CheckBoxStyle}" Margin="8,0,0,0"
                      ToolTip="Stop following new frames and ROI moves." Unchecked="myCheckFreeze_Unchecked"/>
            <Button x:Name="myBtSelectArea" Content="Select Area" Style="{StaticResource ButtonS1Style}" Width="80" Margin="10,0,0,0" FontWeight="SemiBold"
                    ToolTip="Then drag a rectangle on the main preview. Right-click or Esc cancels." Click="myBtSelectArea_Click"/>
            <Button x:Name="myBtResetRoi" Content="Reset" Style="{StaticResource ButtonS1Style}" Width="52" Margin="4,0,0,0"
                    ToolTip="Centred 512 x 512 ROI." Click="myBtResetRoi_Click"/>
            <Button x:Name="myBtSaveRoi" Content="Save ROI" Style="{StaticResource ButtonS1Style}" Width="68" Margin="4,0,0,0"
                    ToolTip="PNG of the ROI at native pixel resolution." Click="myBtSaveRoi_Click"/>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="myTbStatusRoi" Text="ROI: -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="myTbStatusZoom" Text="Zoom: Fit"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="myTbStatusPixel" Text="Pixel: -"/></StatusBarItem>
        </StatusBar>
        <Border x:Name="myViewportHost" Background="{StaticResource ZoomAreaViewportBrush}" ClipToBounds="True"/>
    </DockPanel>
</Window>
