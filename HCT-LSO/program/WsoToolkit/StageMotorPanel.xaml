<UserControl x:Class="WsoToolkit.StageMotorPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Loaded="UserControl_Loaded"
        Unloaded="UserControl_Unloaded"
        IsEnabledChanged="UserControl_IsEnabledChanged">
    <!-- Sized for both hosts: the scan-test screen's bottom-right 790x176 slot and the 660px-wide
         StageMotorWindow. Tab header (~22) + 5 rows of 22 in Advanced stay inside 176px.
         The status line sits in the tab-header strip so refusals show on either tab. -->
    <Grid>
        <TabControl x:Name="tabStage" SelectedIndex="0">
            <TabItem Header="Jog">
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="158"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="172"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Relative steps only (bounded per press); holding repeats after 350 ms. -->
                    <Grid Grid.Column="0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <RepeatButton x:Name="btnJogYplus" Grid.Row="0" Grid.Column="1" Content="Y+" Tag="Y+" ToolTip="Y + one step" Margin="1" Delay="350" Interval="100" Focusable="False" IsTabStop="False" Click="PadButton_Click" PreviewMouseLeftButtonDown="PadButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PadButton_PreviewMouseLeftButtonUp" LostMouseCapture="PadButton_LostMouseCapture"/>
                        <RepeatButton x:Name="btnJogXminus" Grid.Row="1" Grid.Column="0" Content="X-" Tag="X-" ToolTip="X - one step" Margin="1" Delay="350" Interval="100" Focusable="False" IsTabStop="False" Click="PadButton_Click" PreviewMouseLeftButtonDown="PadButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PadButton_PreviewMouseLeftButtonUp" LostMouseCapture="PadButton_LostMouseCapture"/>
                        <RepeatButton x:Name="btnJogXplus" Grid.Row="1" Grid.Column="2" Content="X+" Tag="X+" ToolTip="X + one step" Margin="1" Delay="350" Interval="100" Focusable="False" IsTabStop="False" Click="PadButton_Click" PreviewMouseLeftButtonDown="PadButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PadButton_PreviewMouseLeftButtonUp" LostMouseCapture="PadButton_LostMouseCapture"/>
                        <RepeatButton x:Name="btnJogYminus" Grid.Row="2" Grid.Column="1" Content="Y-" Tag="Y-" ToolTip="Y - one step" Margin="1" Delay="350" Interval="100" Focusable="False" IsTabStop="False" Click="PadButton_Click" PreviewMouseLeftButtonDown="PadButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PadButton_PreviewMouseLeftButtonUp" LostMouseCapture="PadButton_LostMouseCapture"/>
                        <Button x:Name="btnStopAll" Grid.Row="1" Grid.Column="1" Content="STOP ALL" Margin="1" FontSize="10" FontWeight="Bold" Foreground="White" Background="#D32F2F" BorderBrush="#8E0000" Focusable="False" IsTabStop="False" ToolTip="Stop X/Y/Z/Swing and the chinrest (also Esc)" Click="BtnStopAll_Click"/>
                    </Grid>

                    <Grid Grid.Column="2" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <RepeatButton x:Name="btnJogZplus" Grid.Row="0" Grid.Column="0" Content="Z Fwd" Tag="Z Fwd" ToolTip="Z + one step" Margin="1" Delay="350" Interval="100" Focusable="False" IsTabStop="False" Click="PadButton_Click" PreviewMouseLeftButtonDown="PadButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PadButton_PreviewMouseLeftButtonUp" LostMouseCapture="PadButton_LostMouseCapture"/>
                        <TextBlock Grid.Row="1" Text="Z" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <RepeatButton x:Name="btnJogZminus" Grid.Row="2" Grid.Column="0" Content="Z Back" Tag="Z Back" ToolTip="Z - one step" Margin="1" Delay="350" Interval="100" Focusable="False" IsTabStop="False" Click="PadButton_Click" PreviewMouseLeftButtonDown="PadButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PadButton_PreviewMouseLeftButtonUp" LostMouseCapture="PadButton_LostMouseCapture"/>
                    </Grid>

                    <StackPanel Grid.Column="4" VerticalAlignment="Top">
                        <TextBlock Text="Step" FontWeight="SemiBold" Height="16"/>
                        <RadioButton x:Name="rbJogFine" GroupName="groupStageJogSize" Content="Fine (X/Z 1, Y 10)" IsChecked="True" Focusable="False" Height="20" VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="rbJogMed" GroupName="groupStageJogSize" Content="Med (X/Z 5, Y 50)" Focusable="False" Height="20" VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="rbJogCoarse" GroupName="groupStageJogSize" Content="Coarse (X/Z 12, Y 200)" Focusable="False" Height="20" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Chinrest" FontWeight="SemiBold" Height="16" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnJogChinUp" Content="Up (hold)" Width="82" Height="24" Margin="0,0,6,0" Focusable="False" IsTabStop="False" ToolTip="Moves only while pressed" PreviewMouseLeftButtonDown="Chinrest_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Chinrest_PreviewMouseLeftButtonUp" LostMouseCapture="Chinrest_LostMouseCapture"/>
                            <Button x:Name="btnJogChinDown" Content="Down (hold)" Width="82" Height="24" Focusable="False" IsTabStop="False" ToolTip="Moves only while pressed" PreviewMouseLeftButtonDown="Chinrest_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Chinrest_PreviewMouseLeftButtonUp" LostMouseCapture="Chinrest_LostMouseCapture"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="6" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Position" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="X" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtJogXPos" Grid.Row="1" Grid.Column="1" Text="-" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Border x:Name="bdgJogX" Grid.Row="1" Grid.Column="2" CornerRadius="2" Margin="0,2" Background="Transparent">
                            <TextBlock x:Name="txtJogXBadge" Text="" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Y" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtJogYPos" Grid.Row="2" Grid.Column="1" Text="-" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Border x:Name="bdgJogY" Grid.Row="2" Grid.Column="2" CornerRadius="2" Margin="0,2" Background="Transparent">
                            <TextBlock x:Name="txtJogYBadge" Text="" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Z" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtJogZPos" Grid.Row="3" Grid.Column="1" Text="-" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Border x:Name="bdgJogZ" Grid.Row="3" Grid.Column="2" CornerRadius="2" Margin="0,2" Background="Transparent">
                            <TextBlock x:Name="txtJogZBadge" Text="" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Advanced">
                <Grid Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" ToolTip="X Stage" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    <Slider x:Name="sliderXstage" Grid.Row="0" Grid.Column="1" Style="{StaticResource SliderStyle}" Focusable="False" IsTabStop="False" Margin="4,0" ValueChanged="SliderXstage_ValueChanged" Thumb.DragStarted="SliderXstage_DragStarted" Thumb.DragCompleted="SliderXstage_DragCompleted"/>
                    <TextBox x:Name="editXstagePos" Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Position (Enter moves)" KeyDown="EditXstagePos_KeyDown"/>
                    <TextBox x:Name="editXstageValue" Grid.Row="0" Grid.Column="3" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Step for - / + (empty = 10, 10..1000)"/>
                    <Button x:Name="btnXstageBwd" Grid.Row="0" Grid.Column="4" Content="-" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnXstageBwd_Click"/>
                    <Button x:Name="btnXstageFwd" Grid.Row="0" Grid.Column="5" Content="+" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnXstageFwd_Click"/>
                    <Button x:Name="btnXstageOrigin" Grid.Row="0" Grid.Column="6" Content="Org" ToolTip="Move to origin (asks first)" Style="{StaticResource ButtonStyleS1}" Width="38" Height="20" Click="BtnXstageOrigin_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" ToolTip="Y Stage" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    <Slider x:Name="sliderYstage" Grid.Row="1" Grid.Column="1" Style="{StaticResource SliderStyle}" Focusable="False" IsTabStop="False" Margin="4,0" ValueChanged="SliderYstage_ValueChanged" Thumb.DragStarted="SliderYstage_DragStarted" Thumb.DragCompleted="SliderYstage_DragCompleted"/>
                    <TextBox x:Name="editYstagePos" Grid.Row="1" Grid.Column="2" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Position (Enter moves)" KeyDown="EditYstagePos_KeyDown"/>
                    <TextBox x:Name="editYstageValue" Grid.Row="1" Grid.Column="3" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Step for - / + (empty = 10, 10..1000)"/>
                    <Button x:Name="btnYstageBwd" Grid.Row="1" Grid.Column="4" Content="-" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnYstageBwd_Click"/>
                    <Button x:Name="btnYstageFwd" Grid.Row="1" Grid.Column="5" Content="+" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnYstageFwd_Click"/>
                    <Button x:Name="btnYstageOrigin" Grid.Row="1" Grid.Column="6" Content="Org" ToolTip="Move to origin (asks first)" Style="{StaticResource ButtonStyleS1}" Width="38" Height="20" Click="BtnYstageOrigin_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" ToolTip="Z Stage" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    <Slider x:Name="sliderZstage" Grid.Row="2" Grid.Column="1" Style="{StaticResource SliderStyle}" Focusable="False" IsTabStop="False" Margin="4,0" ValueChanged="SliderZstage_ValueChanged" Thumb.DragStarted="SliderZstage_DragStarted" Thumb.DragCompleted="SliderZstage_DragCompleted"/>
                    <TextBox x:Name="editZstagePos" Grid.Row="2" Grid.Column="2" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Position (Enter moves)" KeyDown="EditZstagePos_KeyDown"/>
                    <TextBox x:Name="editZstageValue" Grid.Row="2" Grid.Column="3" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Step for - / + (empty = 10, 10..1000)"/>
                    <Button x:Name="btnZstageBwd" Grid.Row="2" Grid.Column="4" Content="-" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnZstageBwd_Click"/>
                    <Button x:Name="btnZstageFwd" Grid.Row="2" Grid.Column="5" Content="+" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnZstageFwd_Click"/>
                    <Button x:Name="btnZstageOrigin" Grid.Row="2" Grid.Column="6" Content="Org" ToolTip="Move to origin (asks first)" Style="{StaticResource ButtonStyleS1}" Width="38" Height="20" Click="BtnZstageOrigin_Click"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sw" ToolTip="Swing" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    <Slider x:Name="sliderSwing" Grid.Row="3" Grid.Column="1" Style="{StaticResource SliderStyle}" Focusable="False" IsTabStop="False" Margin="4,0" ValueChanged="SliderSwing_ValueChanged" Thumb.DragStarted="SliderSwing_DragStarted" Thumb.DragCompleted="SliderSwing_DragCompleted"/>
                    <TextBox x:Name="editSwingPos" Grid.Row="3" Grid.Column="2" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Position (Enter moves)" KeyDown="EditSwingPos_KeyDown"/>
                    <TextBox x:Name="editSwingValue" Grid.Row="3" Grid.Column="3" Style="{StaticResource TextBoxStyleS1}" Width="42" Height="20" ToolTip="Step for - / + (empty = 10, 10..1000)"/>
                    <Button x:Name="btnSwingBwd" Grid.Row="3" Grid.Column="4" Content="-" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnSwingBwd_Click"/>
                    <Button x:Name="btnSwingFwd" Grid.Row="3" Grid.Column="5" Content="+" Style="{StaticResource ButtonStyleS1}" Width="24" Height="20" Click="BtnSwingFwd_Click"/>
                    <Button x:Name="btnSwingOrigin" Grid.Row="3" Grid.Column="6" Content="Org" ToolTip="Move to origin (asks first)" Style="{StaticResource ButtonStyleS1}" Width="38" Height="20" Click="BtnSwingOrigin_Click"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Chinrest" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="4,0,0,0">
                        <Button x:Name="btnChinrestUp" Content="Up (hold)" ToolTip="Moves only while pressed" Width="72" Height="20" Margin="0,0,6,0" Focusable="False" IsTabStop="False" PreviewMouseLeftButtonDown="Chinrest_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Chinrest_PreviewMouseLeftButtonUp" LostMouseCapture="Chinrest_LostMouseCapture"/>
                        <Button x:Name="btnChinrestDown" Content="Down (hold)" ToolTip="Moves only while pressed" Width="80" Height="20" Margin="0,0,6,0" Focusable="False" IsTabStop="False" PreviewMouseLeftButtonDown="Chinrest_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Chinrest_PreviewMouseLeftButtonUp" LostMouseCapture="Chinrest_LostMouseCapture"/>
                        <Button x:Name="btnChinrestStop" Content="Stop" Width="56" Height="20" Click="BtnChinrestStop_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="txtJogStatus" VerticalAlignment="Top" Height="18" Margin="150,3,6,0" TextTrimming="CharacterEllipsis" Foreground="#B71C1C" Text="" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
</UserControl>
