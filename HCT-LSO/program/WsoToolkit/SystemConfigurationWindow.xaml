<Window x:Class="WsoToolkit.SystemConfigurationWindow"
        Style="{StaticResource WindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WsoToolkit"
        mc:Ignorable="d"
        Title="System Configuration" Height="Auto" Width="Auto" ResizeMode="NoResize" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" SizeToContent="WidthAndHeight">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Grid Margin="8,8,8,8" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,0,0" HorizontalAlignment="Left">
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="12"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="label_Copy23" Content="Internal Fixation Points" Style="{StaticResource HeaderStyle}" Grid.Row="1" Grid.ColumnSpan="3" Margin="16,0,0,0" HorizontalAlignment="Left"/>
                        <Label x:Name="label_Copy24" Content="Fundus (OD)" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="1"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2">
                            <TextBox x:Name="FundusOdXEdit" Style="{StaticResource TextBoxStyleS1}" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                            <TextBox x:Name="FundusOdYEdit" Style="{StaticResource TextBoxStyleS1}" Margin="4,0,0,0" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Label x:Name="label_Copy25" Content="Fundus (OS)" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="4"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2">
                            <TextBox x:Name="FundusOsXEdit" Style="{StaticResource TextBoxStyleS1}" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                            <TextBox x:Name="FundusOsYEdit" Style="{StaticResource TextBoxStyleS1}" Margin="4,0,0,0" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Label x:Name="label_Copy26" Content="Center (OD)" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="1" />
                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2">
                            <TextBox x:Name="FoveaOdXEdit" Style="{StaticResource TextBoxStyleS1}" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                            <TextBox x:Name="FoveaOdYEdit" Style="{StaticResource TextBoxStyleS1}" Margin="4,0,0,0" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Label x:Name="label_Copy27" Content="Center (OS)" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="4"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="2">
                            <TextBox x:Name="FoveaOsXEdit" Style="{StaticResource TextBoxStyleS1}" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                            <TextBox x:Name="FoveaOsYEdit" Style="{StaticResource TextBoxStyleS1}" Margin="4,0,0,0" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Label x:Name="label_Copy28" Content="Optic Disc (OD)" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="1" />
                        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2">
                            <TextBox x:Name="DiscOdXEdit" Style="{StaticResource TextBoxStyleS1}" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                            <TextBox x:Name="DiscOdYEdit" Style="{StaticResource TextBoxStyleS1}" Margin="4,0,0,0" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Label x:Name="label_Copy29" Content="Optic Disc (OS)" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="4"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="2">
                            <TextBox x:Name="DiscOsXEdit" Style="{StaticResource TextBoxStyleS1}" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                            <TextBox x:Name="DiscOsYEdit" Style="{StaticResource TextBoxStyleS1}" Margin="4,0,0,0" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Label x:Name="label_Copy30" Content="Internal Fixation LED" Style="{StaticResource HeaderStyle}" Grid.Row="5" Grid.ColumnSpan="3" Margin="16,0,0,0" HorizontalAlignment="Left"/>
                        <Label x:Name="label_Copy31" Content="Brightness" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="1"/>
                        <TextBox x:Name="FixBrightEdit" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="6" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        <Label x:Name="label_Copy32" Content="Period/OnTime" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="4"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="5" Grid.ColumnSpan="2">
                            <TextBox x:Name="BlinkPeriodEdit" Style="{StaticResource TextBoxStyleS1}" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                            <TextBox x:Name="BlinkOnTimeEdit" Style="{StaticResource TextBoxStyleS1}" Margin="4,0,0,0" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Label x:Name="label_Copy33" Content="Fixation Type" Style="{StaticResource LabelStyle}" Grid.Row="7" Grid.Column="4"/>
                        <TextBox x:Name="FixationTypeEdit" Style="{StaticResource TextBoxStyleS1}" Grid.Column="5" Grid.Row="7" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                        <CheckBox x:Name="BlinkCheckBox" Style="{StaticResource CheckBoxStyle}"  Grid.Column="2" Content="Blink Mode" Grid.Row="7" Grid.ColumnSpan="2"/>
                    </Grid>
                </Border>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                    </Grid.RowDefinitions>
                    <Label x:Name="label301" Content="Cornea IR Camera" Style="{StaticResource HeaderStyle}" Grid.Row="1" Grid.ColumnSpan="3" Margin="16,0,0,0" HorizontalAlignment="Left"/>
                    <Label x:Name="label302" Content="A-gain" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="1"/>
                    <TextBox x:Name="editCorneaAgain1" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="2" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label303" Content="D-gain" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="3"/>
                    <TextBox x:Name="editCorneaDgain1" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="2" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label314" Content="Exposure" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="5"/>
                    <TextBox x:Name="editCorneaExpos1" Style="{StaticResource TextBoxStyleS1}" Grid.Column="6" Grid.Row="2" PreviewTextInput="FloatTextBox_PreviewTextInput"/>

                    <Label x:Name="label304" Content="A-gain" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="1"/>
                    <TextBox x:Name="editCorneaAgain2" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="3" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label305" Content="D-gain" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="3"/>
                    <TextBox x:Name="editCorneaDgain2" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="3" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label315" Content="Exposure" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="5"/>
                    <TextBox x:Name="editCorneaExpos2" Style="{StaticResource TextBoxStyleS1}" Grid.Column="6" Grid.Row="3" PreviewTextInput="FloatTextBox_PreviewTextInput"/>

                    <Label x:Name="label306" Content="A-gain" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="1"/>
                    <TextBox x:Name="editCorneaAgain3" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="4" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label307" Content="D-gain" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="3"/>
                    <TextBox x:Name="editCorneaDgain3" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="4" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label316" Content="Exposure" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="5"/>
                    <TextBox x:Name="editCorneaExpos3" Style="{StaticResource TextBoxStyleS1}" Grid.Column="6" Grid.Row="4" PreviewTextInput="FloatTextBox_PreviewTextInput"/>

                    <Label x:Name="label308" Content="(Left)" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="7" HorizontalAlignment="Left"/>
                    <Label x:Name="label309" Content="(Right)" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="7" HorizontalAlignment="Left"/>
                    <Label x:Name="label310" Content="(Lower)" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="7" HorizontalAlignment="Left"/>
                    <Label x:Name="label311" Content="Retina IR Camera" Style="{StaticResource HeaderStyle}" Grid.Row="5" Grid.ColumnSpan="3" Margin="16,0,0,0" HorizontalAlignment="Left"/>
                    <Label x:Name="label312" Content="A-gain" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="1"/>
                    <TextBox x:Name="editRetinaAgain" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="6" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label313" Content="D-gain" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="3"/>
                    <TextBox x:Name="editRetinaDgain" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="6" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label x:Name="label317" Content="Exposure" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="5"/>
                    <TextBox x:Name="editRetinaExpos" Style="{StaticResource TextBoxStyleS1}" Grid.Column="6" Grid.Row="6" PreviewTextInput="FloatTextBox_PreviewTextInput"/>

                    <Label x:Name="label318" Content="[1~31]" Style="{StaticResource LabelStyle}" Grid.Row="7" Grid.Column="2"/>
                    <Label x:Name="label319" Content="[1~15]" Style="{StaticResource LabelStyle}" Grid.Row="7" Grid.Column="4"/>
                    <Label x:Name="label320" Content="[1~60]" Style="{StaticResource LabelStyle}" Grid.Row="7" Grid.Column="6"/>
                    <Border Style="{StaticResource BorderStyle}" Grid.ColumnSpan="8" Grid.RowSpan="9"/>
                </Grid>
                <!-- Eye alignment (EyeAlign module) parameters: stage positions in motor steps,
                     pixel tolerances, frame counts, timeouts and per-camera pupil target geometry. -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                    </Grid.RowDefinitions>
                    <Label Content="Eye Alignment (steps)" Style="{StaticResource HeaderStyle}" Grid.Row="1" Grid.ColumnSpan="3" Margin="16,0,0,0" HorizontalAlignment="Left"/>
                    <Label Content="Ready Z" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="1"/>
                    <TextBox x:Name="editAlignReadyZ" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="2" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="Search Z" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="3"/>
                    <TextBox x:Name="editAlignSearchZ" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="2" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="Min Safe Z" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="5"/>
                    <TextBox x:Name="editAlignMinSafeZ" Style="{StaticResource TextBoxStyleS1}" Grid.Column="6" Grid.Row="2" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>

                    <Label Content="Eye X (OD)" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="1"/>
                    <TextBox x:Name="editAlignEyeXOD" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="3" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="Eye X (OS)" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="3"/>
                    <TextBox x:Name="editAlignEyeXOS" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="3" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="Pos Tol" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="5"/>
                    <TextBox x:Name="editAlignPosTol" Style="{StaticResource TextBoxStyleS1}" Grid.Column="6" Grid.Row="3" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>

                    <Label Content="Swing (OD)" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="1"/>
                    <TextBox x:Name="editAlignSwingOD" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="4" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="Swing (OS)" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="3"/>
                    <TextBox x:Name="editAlignSwingOS" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="4" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <CheckBox x:Name="checkAlignBackOff" Style="{StaticResource CheckBoxStyle}" Content="Back off Z" Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="2"/>

                    <Label Content="Control (px)" Style="{StaticResource HeaderStyle}" Grid.Row="5" Grid.ColumnSpan="3" Margin="16,0,0,0" HorizontalAlignment="Left"/>
                    <Label Content="Tol XY / Z" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="1"/>
                    <TextBox x:Name="editAlignTolPx" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="6" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignTolZPx" Style="{StaticResource TextBoxStyleS1}" Grid.Column="3" Grid.Row="6" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label Content="Deadband" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="4"/>
                    <TextBox x:Name="editAlignStartDb" Style="{StaticResource TextBoxStyleS1}" Grid.Column="5" Grid.Row="6" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignStopDb" Style="{StaticResource TextBoxStyleS1}" Grid.Column="6" Grid.Row="6" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label Content="(start/stop)" Style="{StaticResource LabelStyle}" Grid.Row="6" Grid.Column="7" HorizontalAlignment="Left"/>

                    <Label Content="Frames" Style="{StaticResource LabelStyle}" Grid.Row="7" Grid.Column="1"/>
                    <TextBox x:Name="editAlignDetectN" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="7" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignSettleN" Style="{StaticResource TextBoxStyleS1}" Grid.Column="3" Grid.Row="7" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLostStop" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="7" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLostCancel" Style="{StaticResource TextBoxStyleS1}" Grid.Column="5" Grid.Row="7" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="(detect/settle/lostStop/lostCancel)" Style="{StaticResource LabelStyle}" Grid.Row="7" Grid.Column="6" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>

                    <Label Content="Filter" Style="{StaticResource LabelStyle}" Grid.Row="8" Grid.Column="1"/>
                    <TextBox x:Name="editAlignMaxJump" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="8" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignSmooth" Style="{StaticResource TextBoxStyleS1}" Grid.Column="3" Grid.Row="8" PreviewTextInput="FloatTextBox_PreviewTextInput"/>
                    <Label Content="(maxJump px / alpha)" Style="{StaticResource LabelStyle}" Grid.Row="8" Grid.Column="4" Grid.ColumnSpan="3" HorizontalAlignment="Left"/>

                    <Label Content="Timeout ms" Style="{StaticResource LabelStyle}" Grid.Row="9" Grid.Column="1"/>
                    <TextBox x:Name="editAlignToReady" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="9" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignToSwing" Style="{StaticResource TextBoxStyleS1}" Grid.Column="3" Grid.Row="9" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignToEyeX" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="9" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignToSearch" Style="{StaticResource TextBoxStyleS1}" Grid.Column="5" Grid.Row="9" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="(ready/swing/eyeX/search)" Style="{StaticResource LabelStyle}" Grid.Row="9" Grid.Column="6" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>

                    <Label Content="Pupil Target" Style="{StaticResource HeaderStyle}" Grid.Row="10" Grid.ColumnSpan="3" Margin="16,0,0,0" HorizontalAlignment="Left"/>
                    <Label Content="tX / tY / sH / sV" Style="{StaticResource LabelStyle}" Grid.Row="10" Grid.Column="3" Grid.ColumnSpan="3" HorizontalAlignment="Left"/>
                    <Label Content="Left" Style="{StaticResource LabelStyle}" Grid.Row="11" Grid.Column="1"/>
                    <TextBox x:Name="editAlignLeftTX" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="11" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLeftTY" Style="{StaticResource TextBoxStyleS1}" Grid.Column="3" Grid.Row="11" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLeftSH" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="11" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLeftSV" Style="{StaticResource TextBoxStyleS1}" Grid.Column="5" Grid.Row="11" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="Right" Style="{StaticResource LabelStyle}" Grid.Row="12" Grid.Column="1"/>
                    <TextBox x:Name="editAlignRightTX" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="12" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignRightTY" Style="{StaticResource TextBoxStyleS1}" Grid.Column="3" Grid.Row="12" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignRightSH" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="12" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignRightSV" Style="{StaticResource TextBoxStyleS1}" Grid.Column="5" Grid.Row="12" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Label Content="Lower" Style="{StaticResource LabelStyle}" Grid.Row="13" Grid.Column="1" Margin="0,0,0,8"/>
                    <TextBox x:Name="editAlignLowerTX" Style="{StaticResource TextBoxStyleS1}" Grid.Column="2" Grid.Row="13" Margin="0,0,0,8" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLowerTY" Style="{StaticResource TextBoxStyleS1}" Grid.Column="3" Grid.Row="13" Margin="0,0,0,8" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLowerSH" Style="{StaticResource TextBoxStyleS1}" Grid.Column="4" Grid.Row="13" Margin="0,0,0,8" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <TextBox x:Name="editAlignLowerSV" Style="{StaticResource TextBoxStyleS1}" Grid.Column="5" Grid.Row="13" Margin="0,0,0,8" PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
                    <Border Style="{StaticResource BorderStyle}" Grid.ColumnSpan="8" Grid.RowSpan="14"/>
                </Grid>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,12">
            <Button x:Name="LoadButton" Content="Load" Style="{StaticResource ButtonStyleM1}" Margin="0,0,8,0" Click="LoadButton_Click"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource ButtonStyleM1}" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button x:Name="btnApply" Content="Apply" Style="{StaticResource ButtonStyleM1}"  Margin="0,0,8,0" Click="BtnApply_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource ButtonStyleM1}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
