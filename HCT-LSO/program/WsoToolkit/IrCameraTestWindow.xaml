<Window x:Class="WsoToolkit.IrCameraTestWindow"
        Style="{StaticResource WindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WsoToolkit"
        xmlns:controls="clr-namespace:WsoToolkit.controls"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
       Title="Ir Camera Test" Height="Auto" Width="Auto" ResizeMode="NoResize" Initialized="Window_Initialized" Loaded="Window_Loaded" Closed="Window_Closed" Closing="Window_Closing">
    <Grid Margin="8,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
            <controls:CorneaCameraPreview x:Name="corneaPreview1" Width="640" Height="512"/>
            <controls:CorneaCameraPreview x:Name="corneaPreview2" Width="640" Height="512"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
            <controls:CorneaCameraPreview x:Name="corneaPreview3" Width="640" Height="512"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,16,0,4">
                <Button x:Name="btnStartCamera" Content="Start Camera" Style="{StaticResource ButtonStyle}" Margin="0" Click="BtnStartCamera_Click"/>
                <Button x:Name="btnSelectFolder" Content="Folder..." Style="{StaticResource ButtonStyle}" Margin="4,0,0,0" ToolTip=".\cornea" Click="BtnSelectFolder_Click"/>
                <TextBox x:Name="txtFileName" Width="180" Margin="4,0,0,0"/>
                <Button x:Name="btnSaveFrame" Content="Save Frame" Style="{StaticResource ButtonStyle}" Margin="4,0,0,0" Click="BtnSaveFrame_Click"/>
                <Button x:Name="btnClose" Content="Close" Style="{StaticResource ButtonStyle}" Margin="4,0,0,0" Click="BtnClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,0,0,4">
                <Button x:Name="btnShowFocusM" Content="FocusM..." Style="{StaticResource ButtonStyle}" Margin="0" Click="BtnShowFocusM_Click"/>
                <Button x:Name="btnShowStageM" Content="StageM..." Style="{StaticResource ButtonStyle}" Margin="4,0,0,0" Click="BtnShowStageM_Click"/>
                <Button x:Name="btnShowLights" Content="Lights..." Style="{StaticResource ButtonStyle}" Margin="4,0,0,0" Click="BtnShowLights_Click"/>
                <Button x:Name="btnShowConfig" Content="Config..." Style="{StaticResource ButtonStyle}" Margin="4,0,0,0" Click="BtnShowConfig_Click"/>
            </StackPanel>

            <Grid Margin="0,16,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                </Grid.RowDefinitions>
                <Label x:Name="label101" Content="Cornea IR Camera" Style="{StaticResource HeaderStyle2}" Margin="12,0,0,0" Grid.Row="1" Grid.ColumnSpan="3"/>
                <Label x:Name="label102" Content="Channel" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="1" />
                <ComboBox x:Name="cmbCorneaChannel" Style="{StaticResource ComboBoxStyle}" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Width="100" SelectionChanged="CmbCorneaChannel_SelectionChanged"/>
                <CheckBox x:Name="checkCorneaAlign" Content="Align Line" Style="{StaticResource CheckBoxStyle}" Grid.Row="2" Grid.Column="4" Click="CheckCorneaAlign_Click"/>
                <CheckBox x:Name="checkCorneaFocus" Content="Focus Line" Style="{StaticResource CheckBoxStyle}" Grid.Row="2" Grid.Column="5" Click="CheckCorneaFocus_Click"/>
                <Label x:Name="label103" Content="A-gain" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="1"/>
                <TextBox x:Name="editCorneaAgain" Style="{StaticResource TextBoxStyle}" Width="60" Grid.Row="3" Grid.Column="2" KeyDown="EditCorneaAgain_KeyDown"/>
                <Label x:Name="label104" Content="[1~31]" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="3"/>
                <Label x:Name="label105" Content="D-gain" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="1"/>
                <TextBox x:Name="editCorneaDgain" Style="{StaticResource TextBoxStyle}" Width="60" Grid.Row="4" Grid.Column="2" KeyDown="EditCorneaDgain_KeyDown"/>
                <Label x:Name="label106" Content="[1~15]" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="3"/>
                <Label x:Name="label107" Content="Output Mode" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="4"/>
                <ComboBox x:Name="cmbOutputMode" Style="{StaticResource ComboBoxStyle}" Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="1" Width="90" SelectionChanged="CmbOutputMode_SelectionChanged"/>
                <Label x:Name="label108" Content="Test Pattern" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="4"/>
                <ComboBox x:Name="cmbTestPattern" Style="{StaticResource ComboBoxStyle}" Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="1" Width="90" SelectionChanged="CmbTestPattern_SelectionChanged"/>
                <Label x:Name="label109" Content="H-flip" Style="{StaticResource LabelStyle}" Grid.Row="3" Grid.Column="6"/>
                <ComboBox x:Name="cmbHorzFlip" Style="{StaticResource ComboBoxStyle}" Grid.Row="3" Grid.Column="7" Grid.ColumnSpan="1" Width="70" SelectionChanged="CmbHorzFlip_SelectionChanged"/>
                <ComboBox x:Name="cmbVertFlip" Style="{StaticResource ComboBoxStyle}" Grid.Row="4" Grid.Column="7" Grid.ColumnSpan="1" Width="70" SelectionChanged="CmbVertFlip_SelectionChanged"/>
                <Label x:Name="label110" Content="V-flip" Style="{StaticResource LabelStyle}" Grid.Row="4" Grid.Column="6"/>
                <Label x:Name="label111" Content="View Format" Style="{StaticResource LabelStyle}" Grid.Row="1" Grid.Column="4"/>
                <ComboBox x:Name="cmbViewFormat" Style="{StaticResource ComboBoxStyle}" Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Width="150" SelectionChanged="CmbViewFormat_SelectionChanged"/>
                <CheckBox x:Name="checkRollingBar" Content="Rolling Bar" Style="{StaticResource CheckBoxStyle}" Grid.Row="5" Grid.Column="5" Click="CheckRollingBar_Click"/>
                <CheckBox x:Name="checkTransparent" Content="Transparent" Style="{StaticResource CheckBoxStyle}" Grid.Row="5" Grid.Column="6" Grid.ColumnSpan="2" Click="CheckTransparent_Click"/>
                <Label x:Name="label112" Content="Exposure" Style="{StaticResource LabelStyle}" Grid.Row="5" Grid.Column="1"/>
                <TextBox x:Name="editCorneaExposure" Style="{StaticResource TextBoxStyle}" Width="60" Grid.Row="5" Grid.Column="2" KeyDown="EditCorneaExposure_KeyDown"/>
                <Label x:Name="label113" Content="[1~300]" Style="{StaticResource LabelStyle}" Grid.Row="5" Grid.Column="3"/>
                <Border Style="{StaticResource BorderStyle}" Grid.ColumnSpan="9" Grid.RowSpan="9"/>
            </Grid>

            <!-- Eye alignment (EyeAlign module). Ctrl+click on a preview injects a pupil
                 position while the detector is still a stub; Ctrl+right click clears it. -->
            <Grid Margin="0,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                </Grid.RowDefinitions>
                <Label Content="Eye Alignment" Style="{StaticResource HeaderStyle2}" Margin="12,0,0,0" Grid.Row="1" Grid.ColumnSpan="3"/>
                <Label x:Name="lblAlignStatus" Content="Idle" Style="{StaticResource LabelStyle}" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="4" HorizontalAlignment="Left"/>
                <Label Content="Mode" Style="{StaticResource LabelStyle}" Grid.Row="2" Grid.Column="1"/>
                <ComboBox x:Name="cmbAlignMode" Style="{StaticResource ComboBoxStyle}" Grid.Row="2" Grid.Column="2" Width="100"/>
                <ComboBox x:Name="cmbAlignEyeSide" Style="{StaticResource ComboBoxStyle}" Grid.Row="2" Grid.Column="3" Width="100"/>
                <Button x:Name="btnAlignStart" Content="Start Align" Style="{StaticResource ButtonStyleM1}" Grid.Row="2" Grid.Column="4" Click="BtnAlignStart_Click"/>
                <Button x:Name="btnAlignHold" Content="Hold" Style="{StaticResource ButtonStyleM1}" Grid.Row="2" Grid.Column="5" Click="BtnAlignHold_Click"/>
                <CheckBox x:Name="checkPupilOverlay" Content="Pupil Mark" Style="{StaticResource CheckBoxStyle}" Grid.Row="3" Grid.Column="2" Click="CheckPupilOverlay_Click"/>
                <Button x:Name="btnClearOverride" Content="Clear Override" Style="{StaticResource ButtonStyleM1}" Grid.Row="3" Grid.Column="4" Click="BtnClearOverride_Click"/>
                <Button x:Name="btnClearEvents" Content="Clear Events" Style="{StaticResource ButtonStyleM1}" Grid.Row="3" Grid.Column="5" Click="BtnClearEvents_Click"/>
                <ListBox x:Name="listAlignEvents" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="6" Height="140" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"/>
                <Border Style="{StaticResource BorderStyle}" Grid.ColumnSpan="8" Grid.RowSpan="6"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
