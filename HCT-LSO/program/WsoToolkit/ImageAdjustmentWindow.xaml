<Window x:Class="WsoToolkit.ImageAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WsoToolkit"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Image Adjustment" Height="760" Width="420" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <!-- Rows are Auto and the controls scroll, so the radial curve keeps a usable height no
         matter how many adjust rows there are. The buttons stay outside the ScrollViewer. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="60"/>
                </Grid.ColumnDefinitions>

                <!-- Channel View : display one channel as grayscale (Green = red-free) -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <Label Content="Channel : " Style="{StaticResource LabelStyle}"/>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="myRadioChannelRgb" Content="RGB" Tag="Rgb" GroupName="ChannelView"
                                     Style="{StaticResource RadioButtonStyle}" Margin="4,0"
                                     IsChecked="True" Checked="AdjustChannel_Checked"/>
                        <RadioButton x:Name="myRadioChannelR" Content="R" Tag="Red" GroupName="ChannelView"
                                     Style="{StaticResource RadioButtonStyle}" Margin="4,0"
                                     Checked="AdjustChannel_Checked"/>
                        <RadioButton x:Name="myRadioChannelG" Content="G" Tag="Green" GroupName="ChannelView"
                                     Style="{StaticResource RadioButtonStyle}" Margin="4,0"
                                     Checked="AdjustChannel_Checked"/>
                        <RadioButton x:Name="myRadioChannelB" Content="B" Tag="Blue" GroupName="ChannelView"
                                     Style="{StaticResource RadioButtonStyle}" Margin="4,0"
                                     Checked="AdjustChannel_Checked"/>
                    </StackPanel>
                </Grid>

                <!-- Brightness -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <Label Content="Brightness : " Style="{StaticResource LabelStyle}"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" Margin="5">
                    <Slider x:Name="mySliderBright" Tag="Brightness"
                            Minimum="-100" Maximum="100"
                            TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="Gray"
                            ValueChanged="AdjustSlider_ValueChanged"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="2">
                    <TextBox x:Name="myTbBright" Tag="Brightness" Style="{StaticResource TextBoxS1Style}"
                             Text="{Binding ElementName=mySliderBright, Path=Value, Mode=OneWay, StringFormat=F0}"
                             HorizontalAlignment="Center" KeyDown="AdjustText_KeyDown"/>
                </Grid>

                <!-- Contrast -->
                <Grid Grid.Row="2" Grid.Column="0">
                    <Label Content="Contrast : " Style="{StaticResource LabelStyle}"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="5">
                    <Slider x:Name="mySliderContrast" Tag="Contrast"
                            Minimum="-100" Maximum="100"
                            TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="Gray"
                            ValueChanged="AdjustSlider_ValueChanged"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="2">
                    <TextBox x:Name="myTbContrast" Tag="Contrast" Style="{StaticResource TextBoxS1Style}"
                             Text="{Binding ElementName=mySliderContrast, Path=Value, Mode=OneWay, StringFormat=F0}"
                             HorizontalAlignment="Center" KeyDown="AdjustText_KeyDown"/>
                </Grid>

                <!-- Gamma -->
                <Grid Grid.Row="3" Grid.Column="0">
                    <Label Content="Gamma : " Style="{StaticResource LabelStyle}"/>
                </Grid>
                <Grid Grid.Row="3" Grid.Column="1" Margin="5">
                    <Slider x:Name="mySliderGamma" Tag="Gamma"
                            Minimum="0.1" Maximum="5.0" Value="1.0"
                            TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="Gray"
                            ValueChanged="AdjustSlider_ValueChanged"/>
                </Grid>
                <Grid Grid.Row="3" Grid.Column="2">
                    <TextBox x:Name="myTbGamma" Tag="Gamma" Style="{StaticResource TextBoxS1Style}"
                             Text="{Binding ElementName=mySliderGamma, Path=Value, Mode=OneWay, StringFormat=F1}"
                             HorizontalAlignment="Center" KeyDown="AdjustText_KeyDown"/>
                </Grid>

                <!-- Sharpness : negative values smooth instead of sharpen -->
                <Grid Grid.Row="4" Grid.Column="0">
                    <Label Content="Sharpness : " Style="{StaticResource LabelStyle}"/>
                </Grid>
                <Grid Grid.Row="4" Grid.Column="1" Margin="5">
                    <Slider x:Name="mySliderSharpness" Tag="Sharpness"
                            Minimum="-100" Maximum="100"
                            TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="Gray"
                            ValueChanged="AdjustSlider_ValueChanged"/>
                </Grid>
                <Grid Grid.Row="4" Grid.Column="2">
                    <TextBox x:Name="myTbSharpness" Tag="Sharpness" Style="{StaticResource TextBoxS1Style}"
                             Text="{Binding ElementName=mySliderSharpness, Path=Value, Mode=OneWay, StringFormat=F0}"
                             HorizontalAlignment="Center" KeyDown="AdjustText_KeyDown"/>
                </Grid>

                <!-- Saturation -->
                <Grid Grid.Row="5" Grid.Column="0">
                    <Label Content="Saturation : " Style="{StaticResource LabelStyle}"/>
                </Grid>
                <Grid Grid.Row="5" Grid.Column="1" Margin="5">
                    <Slider x:Name="mySliderSaturation" Tag="Saturation"
                            Minimum="-100" Maximum="100"
                            TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="Gray"
                            ValueChanged="AdjustSlider_ValueChanged"/>
                </Grid>
                <Grid Grid.Row="5" Grid.Column="2">
                    <TextBox x:Name="myTbSaturation" Tag="Saturation" Style="{StaticResource TextBoxS1Style}"
                             Text="{Binding ElementName=mySliderSaturation, Path=Value, Mode=OneWay, StringFormat=F0}"
                             HorizontalAlignment="Center" KeyDown="AdjustText_KeyDown"/>
                </Grid>

                <!-- Radial Correction : collapsed by default so the curve editor only takes
                     room when it is actually being used -->
                <Expander Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                          Header="Radial Correction" Margin="10,5" IsExpanded="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="myCheckRadialCorrection" Content="Enable"
                                  Style="{StaticResource CheckBoxStyle}" Margin="10,5"
                                  Checked="myCheckRadialCorrection_CheckedNUnChecked"
                                  Unchecked="myCheckRadialCorrection_CheckedNUnChecked"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="myTbRadialCorrection"
                                 Style="{StaticResource TextBoxS1Style}"
                                 Text="1" HorizontalAlignment="Center"
                                 KeyDown="myTbRadialCorrection_KeyDown"/>

                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                BorderBrush="Gray" BorderThickness="1" Height="220" Margin="5">
                            <oxy:PlotView x:Name="plotView"
                                          Model="{Binding PlotModel}"
                                          Background="White"
                                          MouseDown="PlotView_MouseDown"
                                          MouseMove="PlotView_MouseMove"
                                          MouseUp="PlotView_MouseUp">
                            </oxy:PlotView>
                        </Border>
                    </Grid>
                </Expander>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="myBtReset" Content="Reset"
                    Style="{StaticResource ButtonM1Style}"
                    Click="myBtReset_Click" Width="80" Margin="5"/>
            <Button Grid.Column="2" x:Name="myBtClose" Content="Close"
                    Style="{StaticResource ButtonM1Style}"
                    Click="myBtClose_Click" Width="80" Margin="5"/>
        </Grid>
    </Grid>
</Window>
