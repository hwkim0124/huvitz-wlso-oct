<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <BaseOutputPath>$(SolutionDir)build\$(PlatformTarget)\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="call prebuild.bat $(SolutionDir)\externs\dlls $(OutputPath) $(SolutionDir)models" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="call postbuild.bat $(OutputPath) $(SolutionDir)..\..\..\..\build\$(Configuration)\runtime" />
  </Target>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260602" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="vcpkg-wsotoolkit" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\module\WsoNativeLib\WsoNativeLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <!-- PreserveNewest, not Always, for the same reason as the seeded presets below: the app
         WRITES this file. It carries [MODE_PRESET] (which preset each mode is running, plus the
         one-shot migration guards), so an Always copy handed every rebuild a file with no
         selection and no guards - the V1 merge then overwrote the active presets' scan section
         with the seed values and the DevKit installer created and selected a fresh numbered
         copy. Updating the seed on an existing install is now a manual delete. -->
    <None Update="WsoDeviceCfg.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Seeded camera presets, shipped next to the app like WsoDeviceCfg.ini.
         PreserveNewest, not Always: the app writes these very files when a preset is saved,
         so a rebuild must not throw an operator's saved preset away - while an updated seed
         in the repository still wins over an untouched copy. -->
    <None Update="CameraPresets\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
