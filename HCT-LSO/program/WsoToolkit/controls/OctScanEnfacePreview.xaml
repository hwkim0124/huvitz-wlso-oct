<UserControl x:Class="WsoToolkit.controls.OctScanEnfacePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WsoToolkit.controls"
             mc:Ignorable="d">
    <Grid Background="White">
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="256"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Grid x:Name="imageBorder" Grid.Row="0" Grid.Column="0" Background="LightGray">
                <Image x:Name="imageViewport" Style="{StaticResource ImageStyle}" Stretch="Uniform"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="8,0,8,0">
                <Label x:Name="lblStatus" Content="Pattern Enface" Height="Auto" Style="{StaticResource LabelStyle}"/>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource BorderStyle}"/>
    </Grid>
</UserControl>
